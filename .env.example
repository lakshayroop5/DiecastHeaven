# Database Configuration
# Local Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (Turso/libSQL)
# DATABASE_URL="libsql://your-app-name.turso.io"
# DATABASE_AUTH_TOKEN="your-auth-token-here"

# ---------------------------------------------------------------------------
# Site URL - MUST be set in production.
#
# This was missing from the Vercel environment, which is why the live sitemap
# and robots.txt shipped 225 `http://localhost:3000` URLs. `lib/seo/site.ts` now
# falls back to https://www.diecastheavenudaipur.in, but set it explicitly.
#
# Use the www host: the apex 308-redirects to www and the TLS certificate only
# covers www, so any other value produces canonicals that redirect.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.diecastheavenudaipur.in"

# Local development override
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Search Console verification token (rendered into a meta tag)
# GOOGLE_SITE_VERIFICATION=""

# IndexNow key - must match the filename in public/<key>.txt
# INDEXNOW_KEY="8f2c4a6e1b9d73054ce8a1f6b2d90e37"

# Google Merchant Center product category override for the feed
# GOOGLE_PRODUCT_CATEGORY="Toys & Games > Toys > Play Vehicles > Toy Cars & Trucks"

# Admin + Analytics passwords
# ADMIN_PASSWORD="your-admin-password"
# ANALYTICS_PASSWORD="your-analytics-password"
