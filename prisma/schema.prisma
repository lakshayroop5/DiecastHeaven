generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("brands")
}

model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  products    ProductCategory[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  shortDesc   String?           @map("short_desc")
  scale       String?
  price       Float?
  offerPrice  Float?            @map("offer_price")
  status        String            @default("DRAFT")
  featured      Boolean           @default(false)
  sortOrder     Int               @default(0) @map("sort_order")
  stock         Int               @default(0)
  orderType     String            @default("RTD") @map("order_type")
  depositAmount Float?            @map("deposit_amount")
  brandId     String?           @map("brand_id")
  brand       Brand?            @relation(fields: [brandId], references: [id])
  categories  ProductCategory[]
  images      ProductImage[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

model HeroMedia {
  id        String   @id @default(cuid())
  url       String
  type      String   @default("IMAGE")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("hero_media")
}

model SiteSetting {
  id                     String   @id @default(cuid())
  businessName           String   @map("business_name")
  whatsappNumber         String   @map("whatsapp_number")
  whatsappDefaultMessage String   @map("whatsapp_default_message")
  heroTitle              String?  @map("hero_title")
  heroSubtitle           String?  @map("hero_subtitle")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
